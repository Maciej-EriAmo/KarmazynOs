// TB.4 Phase 0 — classify_byte smoke (uses lex_common)
// Exit 0 on pass.

#include "lex_common.k0"

fn main() -> i32 {
    // 'A' = 65 → IDENT
    if classify_byte(65) != 1 {
        return 1;
    }
    // '7' = 55 → INT
    if classify_byte(55) != 2 {
        return 2;
    }
    // ' ' = 32 → WS
    if classify_byte(32) != 3 {
        return 3;
    }
    // '+' = 43 → punct
    if classify_byte(43) != 4 {
        return 4;
    }
    // NUL → EOF kind
    if classify_byte(0) != 0 {
        return 5;
    }
    // '_' → ident
    if classify_byte(95) != 1 {
        return 6;
    }
    return 0;
}
