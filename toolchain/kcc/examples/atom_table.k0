// TB.2b+ — mini atom table with #include + array params (own kcc).
#include "thermal_lib.k0"

// Vacuum: dead + !pinned → clear slot. Returns reaped count.
// Array params compile to C pointers (foreign ABI surface; logic is ours).
fn vacuum_pass(used: [bool; 8], pinned: [bool; 8], temp: [f64; 8]) -> i32 {
    let i: i32 = 0;
    let reaped: i32 = 0;
    while i < 8 {
        if used[i] {
            if is_dead(temp[i]) {
                if pinned[i] {
                } else {
                    used[i] = false;
                    reaped = reaped + 1;
                }
            }
        }
        i = i + 1;
    }
    return reaped;
}

fn cool_all(used: [bool; 8], temp: [f64; 8], n: i32) -> i32 {
    let step: i32 = 0;
    let i: i32 = 0;
    while step < n {
        i = 0;
        while i < 8 {
            if used[i] {
                temp[i] = tick_t(temp[i]);
            }
            i = i + 1;
        }
        step = step + 1;
    }
    return 0;
}

fn count_live(used: [bool; 8]) -> i32 {
    let i: i32 = 0;
    let live: i32 = 0;
    while i < 8 {
        if used[i] {
            live = live + 1;
        }
        i = i + 1;
    }
    return live;
}

fn alloc_slot(used: [bool; 8]) -> i32 {
    let i: i32 = 0;
    while i < 8 {
        if used[i] {
        } else {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

fn main() -> i32 {
    let used: [bool; 8];
    let pinned: [bool; 8];
    let temp: [f64; 8];
    let i: i32 = 0;
    let reaped: i32 = 0;
    let live: i32 = 0;
    let aid: i32 = 0;

    i = 0;
    while i < 8 {
        used[i] = false;
        pinned[i] = false;
        temp[i] = 0.0;
        i = i + 1;
    }

    used[0] = true;
    pinned[0] = false;
    temp[0] = t_init();

    used[1] = true;
    pinned[1] = true;
    temp[1] = t_init();

    cool_all(used, temp, 80);
    reaped = vacuum_pass(used, pinned, temp);

    if used[0] { return 10; }
    if reaped < 1 { return 11; }
    if used[1] {
    } else {
        return 12;
    }
    if is_dead(temp[1]) {
    } else {
        return 13;
    }

    temp[1] = heat(temp[1], heat_read());
    if is_dead(temp[1]) { return 14; }

    live = count_live(used);
    if live != 1 { return 15; }

    aid = alloc_slot(used);
    if aid < 0 { return 16; }
    used[aid] = true;
    pinned[aid] = false;
    temp[aid] = t_init();
    if used[aid] {
    } else {
        return 17;
    }

    // state_code from thermal_lib
    if state_code(80.0) != 3 { return 18; }
    if state_code(t_init()) != 2 { return 19; }

    return 0;
}
