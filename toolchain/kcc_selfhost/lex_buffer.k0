// TB.4 Phase 1 — lexer buffer golden fixtures (exit 0).

#include "lex_engine.k0"

fn expect_tok(
    kinds: [i32; 32],
    starts: [i32; 32],
    ends: [i32; 32],
    idx: i32,
    ek: i32,
    es: i32,
    ee: i32
) -> i32 {
    if kinds[idx] != ek {
        return 1;
    }
    if starts[idx] != es {
        return 1;
    }
    if ends[idx] != ee {
        return 1;
    }
    return 0;
}

fn main() -> i32 {
    let src: [i32; 64];
    let kinds: [i32; 32];
    let starts: [i32; 32];
    let ends: [i32; 32];
    let n: i32 = 0;
    let nt: i32 = 0;

    // A: a=12+b
    src[0] = 97;
    src[1] = 61;
    src[2] = 49;
    src[3] = 50;
    src[4] = 43;
    src[5] = 98;
    n = 6;
    nt = lex_fill(src, n, kinds, starts, ends);
    if nt != 6 {
        return 10;
    }
    if expect_tok(kinds, starts, ends, 0, 1, 0, 1) != 0 {
        return 11;
    }
    if expect_tok(kinds, starts, ends, 1, 4, 1, 2) != 0 {
        return 12;
    }
    if expect_tok(kinds, starts, ends, 2, 2, 2, 4) != 0 {
        return 13;
    }
    if expect_tok(kinds, starts, ends, 3, 4, 4, 5) != 0 {
        return 14;
    }
    if expect_tok(kinds, starts, ends, 4, 1, 5, 6) != 0 {
        return 15;
    }
    if expect_tok(kinds, starts, ends, 5, 0, 6, 6) != 0 {
        return 16;
    }

    // B: x = 7
    src[0] = 120;
    src[1] = 32;
    src[2] = 61;
    src[3] = 32;
    src[4] = 55;
    n = 5;
    nt = lex_fill(src, n, kinds, starts, ends);
    if nt != 4 {
        return 20;
    }
    if expect_tok(kinds, starts, ends, 0, 1, 0, 1) != 0 {
        return 21;
    }
    if expect_tok(kinds, starts, ends, 1, 4, 2, 3) != 0 {
        return 22;
    }
    if expect_tok(kinds, starts, ends, 2, 2, 4, 5) != 0 {
        return 23;
    }
    if expect_tok(kinds, starts, ends, 3, 0, 5, 5) != 0 {
        return 24;
    }

    // C: //z\nab
    src[0] = 47;
    src[1] = 47;
    src[2] = 122;
    src[3] = 10;
    src[4] = 97;
    src[5] = 98;
    n = 6;
    nt = lex_fill(src, n, kinds, starts, ends);
    if nt != 2 {
        return 30;
    }
    if expect_tok(kinds, starts, ends, 0, 1, 4, 6) != 0 {
        return 31;
    }
    if expect_tok(kinds, starts, ends, 1, 0, 6, 6) != 0 {
        return 32;
    }

    // D: fn
    src[0] = 102;
    src[1] = 110;
    n = 2;
    nt = lex_fill(src, n, kinds, starts, ends);
    if nt != 2 {
        return 40;
    }
    if expect_tok(kinds, starts, ends, 0, 1, 0, 2) != 0 {
        return 41;
    }

    return 0;
}
