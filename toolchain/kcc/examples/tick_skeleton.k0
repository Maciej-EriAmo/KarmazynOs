// TB.2 — single-atom T lifecycle. Uses shared thermal_lib.
#include "thermal_lib.k0"

fn cool_until_dead(t: f64, max_steps: i32) -> i32 {
    let x: f64 = t;
    let i: i32 = 0;
    while i < max_steps {
        if is_dead(x) {
            return i;
        }
        x = tick_t(x);
        i = i + 1;
    }
    return -1;
}

fn main() -> i32 {
    let t: f64 = 50.0;
    t = tick_t(t);
    if is_dead(t) { return 1; }
    t = 1.5;
    if !is_dead(t) { return 2; }
    t = heat(t, 10.0);
    if is_dead(t) { return 3; }
    let steps: i32 = cool_until_dead(50.0, 80);
    if steps < 0 { return 4; }
    if steps < 10 { return 5; }
    return 0;
}
