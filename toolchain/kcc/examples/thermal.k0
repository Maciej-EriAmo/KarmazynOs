// Critical thermal law + battery — OWN kcc.
#include "thermal_lib.k0"

fn check_state_table() -> i32 {
    if state_code(100.0) != 3 { return 20; }
    if state_code(70.0) != 3 { return 21; }
    if state_code(69.999) != 2 { return 22; }
    if state_code(50.0) != 2 { return 23; }
    if state_code(30.0) != 2 { return 24; }
    if state_code(29.999) != 1 { return 25; }
    if state_code(2.0) != 1 { return 26; }
    if state_code(1.999) != 0 { return 27; }
    if state_code(0.0) != 0 { return 28; }
    if state_code(80.0) != 3 { return 29; }
    if state_code(10.0) != 1 { return 30; }
    if state_code(1.0) != 0 { return 31; }
    return 0;
}

fn check_decay_heat() -> i32 {
    let t1: f64 = tick_t(50.0);
    if t1 < 45.9 { return 40; }
    if t1 > 46.1 { return 41; }
    let cold: f64 = decay_n(50.0, 0.92, 80);
    if !is_dead(cold) { return 42; }
    let h: f64 = heat(1.0, 10.0);
    if is_dead(h) { return 43; }
    if state_code(h) != 1 { return 44; }
    return 0;
}

fn main() -> i32 {
    let r: i32 = check_state_table();
    if r != 0 { return r; }
    r = check_decay_heat();
    if r != 0 { return r; }
    if !is_dead(1.0) { return 14; }
    if is_dead(50.0) { return 15; }
    return 0;
}
